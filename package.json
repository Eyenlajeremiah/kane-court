{
  "name": "kane-court",
  "version": "0.2.1",
  "private": false,
  "type": "module",
  "scripts": {
    "start": "bash scripts/serve.sh start",
    "test": "node --test",
    "kane": "bash scripts/run-case.sh",
    "loop": "bash scripts/loop.sh",
    "verify": "node bin/kane-court.js verify",
    "mcp": "node mcp/server.js",
    "lock": "node scripts/lock-files.js --init",
    "replay": "bash scripts/replay.sh",
    "record": "bash scripts/record-flows.sh",
    "trial": "node bin/kane-court.js trial",
    "serve": "bash scripts/serve.sh",
    "serve:stop": "bash scripts/serve.sh stop",
    "start:fg": "node server.js"
  },
  "description": "An adversarial QA court: Kane CLI (a real browser agent) judges your app on five adversarial personas, and a verdict is published only when the green is earned.",
  "license": "MIT",
  "keywords": [
    "kane",
    "kane-cli",
    "qa",
    "testing",
    "ai",
    "browser-agent",
    "adversarial",
    "hackathon"
  ],
  "bin": {
    "kane-court": "bin/kane-court.js"
  },
  "files": [
    ".testmuai/tests/",
    "AGENTS.md",
    "README.md",
    "bin/",
    "data/verdicts.json",
    "data/queue.json",
    "lib/kane-court-core.js",
    "lib/evidence-attestation.js",
    "lib/network-policy.js",
    "lib/queue-store.js",
    "lib/round-validation.js",
    "lib/network-policy.js",
    "lib/personas.json",
    "lib/round-validation.js",
    "mcp/",
    "public/",
    "scripts/",
    "server.js",
    "targets/",
    "docs/",
    "tests/",
    ".agents/",
    ".gitattributes",
    ".gitignore",
    ".npmignore"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eyenlajeremiah/kane-court.git"
  },
  "homepage": "https://github.com/Eyenlajeremiah/kane-court",
  "bugs": {
    "url": "https://github.com/Eyenlajeremiah/kane-court/issues"
  }
}
